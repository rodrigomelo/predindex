# PredIndex Backend Environment Variables
# Copy this to .env and fill in your values

# App
DEBUG=true

# Server
# PORT=5004

# Database
# Local dev (PostgreSQL)
DATABASE_URL=postgresql://predindex:predindex@localhost:5432/predindex
# Production
# DATABASE_URL=postgresql://predindex:CHANGE_ME@localhost:5432/predindex

# External APIs (optional)
# ALPHA_VANTAGE_API_KEY=your_key_here
